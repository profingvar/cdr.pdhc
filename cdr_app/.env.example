# cdr.pdhc environment — copy to .env and fill in
FLASK_APP=app
FLASK_ENV=development

# Database
POSTGRES_USER=cdr_user
POSTGRES_PASSWORD=cdr_pass
POSTGRES_DB=cdr_db
DATABASE_URL=postgresql://cdr_user:cdr_pass@localhost:9047/cdr_db

# Service keys (shared secrets for inbound auth from gateways)
GATEWAY_PDHC_SERVICE_KEY=
TWOGATE_PDHC_SERVICE_KEY=

# Cambio CDR sandbox (set CAMBIO_DELIVERY_ENABLED=true to activate)
CAMBIO_DELIVERY_ENABLED=false
CAMBIO_CLIENT_ID=
CAMBIO_CLIENT_SECRET=
CAMBIO_TOKEN_URL=
CAMBIO_BASE_URL=
CAMBIO_TENANT=sandbox-dev
CAMBIO_COMMISSION_HSA_ID=
CAMBIO_HEALTHCARE_UNIT_HSA_ID=
CAMBIO_HEALTHCARE_PROVIDER_HSA_ID=
CAMBIO_ORG_ID=

FLASK_SECRET_KEY=

# Read-side lockdown (#293). When true, only X-Source-Service:
# dashboard.pdhc is permitted on read endpoints (/api/v1/fhir/*,
# /api/v1/canonical/*, /api/v1/openehr/*, /api/v1/stats,
# /api/v1/cambio/*). Ingest endpoints stay public and accept
# gateway.pdhc + sim.pdhc as before.
# Set true on cdr2-5 + cdr_6. cdr1 ships false because gateway
# writes to cdr1 directly per SSOT.
CDR_READ_LOCKDOWN=false

# #422 — ips.pdhc consent verdicts (analysis-filter). Required in prod;
# unset => operator analysis reads fail closed (503).
IPS_BASE_URL=https://ips.pdhc.se

# #730 — this service's OWN ips ApiKey, used only when a read has no operator
# session: gateway, analyse and sim all call the consent gate without one.
# ips's require_auth reads ONLY the Authorization header, so without this the
# request went out unauthenticated, ips answered 401, and the gate refused the
# whole read instead of filtering it — safe, non-functional, and reported as
# though ips were down. Mint with:
#   POST https://ips.pdhc.se/api/v1/auth/keys   (existing ApiKey or SSO bearer)
# Unset => service-shaped analysis reads still fail closed, but now say that a
# credential is missing rather than blaming ips.
IPS_API_KEY=

# #471/#462 item5 — plan.pdhc for concept display-name resolution on the
# clinical read surface (/api/v1/clinical/*). Unset/empty DISABLES display
# resolution (resolve_display short-circuits to None), so the clinical
# dashboard shows raw urn:pdhc:concept/<guid> instead of names. Must be
# reachable from INSIDE the container — use host.docker.internal, NOT the
# 127.0.0.1 default (unreachable from the container).
PLAN_BASE_URL=http://host.docker.internal:9030

# #833 — xlate.pdhc, the foreign-coding translation service. LEAVE UNSET.
# There is no xlate deployment on the platform: no release directory, nothing
# listening on 9016 or 9017. xlate's own .env.example sets APP_PORT=9017 and
# DB_PORT=9016, so CLAUDE.md §3's "9016 declared" is its DATABASE port.
#
# Unset is the CORRECT state and is now honest about itself. A foreign coding
# (one whose system is neither https://plan.pdhc.se/Concept nor
# https://termbank.pdhc.se/) is refused 422 + xlate_not_configured — terminal,
# so the producer stops and sends a translatable coding instead.
#
# Setting this to a host that does not answer is WORSE than leaving it blank:
# the write then fails 503 + transient, which tells the producer to retry, and
# it retries forever. That was the live defect — cdr1 relied on a hardcoded
# http://127.0.0.1:9017 fallback (since removed) and cdr2/cdr3 set
# host.docker.internal:9017; both unreachable, both an endless 503.
# Set it only when a real xlate.pdhc is actually deployed and reachable.
XLATE_BASE_URL=
